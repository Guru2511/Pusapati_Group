{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "portfolio_url": {
      "type": "string"
    },
    "cover_note": {
      "type": "string"
    },
    "is_internship": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "screening",
        "interview",
        "offer",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "phone",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}