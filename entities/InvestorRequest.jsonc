{
  "name": "InvestorRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "organisation": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "investor_type": {
      "type": "string",
      "enum": [
        "institutional",
        "family_office",
        "hni",
        "strategic",
        "other"
      ]
    },
    "areas_of_interest": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "review",
        "shared",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email",
    "investor_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}