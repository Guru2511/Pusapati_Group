{
  "name": "VendorApplication",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "gstin": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "years_in_business": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "documents_pending",
        "verification",
        "approved",
        "rejected"
      ],
      "default": "new"
    }
  },
  "required": [
    "company_name",
    "contact_name",
    "phone",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}